rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'coach';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isCoach());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'player';
      allow update: if signedIn() && (
                      isCoach() ||
                      (request.auth.uid == uid
                       && request.resource.data.role == resource.data.role
                       && request.resource.data.playerId == resource.data.playerId)
                    );
    }

    match /players/{id}   { allow read: if signedIn(); allow write: if isCoach(); }
    match /events/{id}    { allow read: if signedIn(); allow write: if isCoach(); }
    match /gameStats/{id} { allow read: if signedIn(); allow write: if isCoach(); }
    match /lineups/{id}   { allow read: if signedIn(); allow write: if isCoach(); }

    match /attendance/{id} {
      allow read: if signedIn();
      allow write: if isCoach()
        || (signedIn()
            && request.resource.data.playerId == myProfile().playerId
            && request.resource.data.status in ['present', 'late']);
    }
  }
}
